    const descEl = el('div','card-desc', p.desc);
    const metaEl = el('div','card-meta');
    const metaLabel = el('b','', 'Khối lượng: ');
    const metaVal = el('span','', p.weight);
    metaEl.appendChild(metaLabel); metaEl.appendChild(metaVal);

    if(editMode){
      nameEl.contentEditable = 'true';
      nameEl.addEventListener('blur', () => { p.name = nameEl.textContent.trim(); });
      descEl.contentEditable = 'true';
      descEl.addEventListener('blur', () => { p.desc = descEl.textContent.trim(); });
      metaVal.contentEditable = 'true';
      metaVal.addEventListener('blur', () => { p.weight = metaVal.textContent.trim(); });
