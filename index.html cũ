    body.appendChild(nameEl);
    body.appendChild(descEl);
    body.appendChild(metaEl);

    const priceRow = el('div','price-row');
    const priceEl = el('div','price', fmt(p.price));
    if(editMode){
      priceEl.contentEditable = 'true';
      priceEl.addEventListener('blur', () => {
        const digits = priceEl.textContent.replace(/[^0-9]/g,'');
        p.price = parseInt(digits || '0', 10);
        priceEl.textContent = fmt(p.price);
      });
    }
    priceRow.appendChild(priceEl);

    const rightWrap = el('div','','');
    rightWrap.style.display = 'flex';
    rightWrap.style.flexDirection = 'column';
    rightWrap.style.alignItems = 'flex-end';
    rightWrap.style.gap = '8px';

    if(!editMode){
      const stepper = el('div','qty-stepper');
      const minusBtn = el('button','qty-btn','−');
      const qtyVal = el('span','qty-val', String(pendingQty[p.id]));
      const plusBtn = el('button','qty-btn','+');
      minusBtn.onclick = () => { if(pendingQty[p.id] > 1){ pendingQty[p.id]--; qtyVal.textContent = pendingQty[p.id]; } };
      plusBtn.onclick = () => { pendingQty[p.id]++; qtyVal.textContent = pendingQty[p.id]; };
      stepper.appendChild(minusBtn); stepper.appendChild(qtyVal); stepper.appendChild(plusBtn);

      const addBtn = el('button','add-btn','Thêm vào giỏ');
