function validatePhone(phone){
  return /^(0|\+84)[0-9]{8,10}$/.test(phone.replace(/[\s.-]/g,''));
}

function submitOrder(){
  const name = document.getElementById('custName').value.trim();
  const phone = document.getElementById('custPhone').value.trim();
  const address = document.getElementById('custAddress').value.trim();
  const dateVal = document.getElementById('custDate').value;
  const note = document.getElementById('custNote').value.trim();

  const phoneError = document.getElementById('phoneError');
  const dateError = document.getElementById('dateError');
  phoneError.textContent = '';
  dateError.textContent = '';

  let valid = true;

  if(!name || !phone || !address || !dateVal){
    valid = false;
    if(!phone) phoneError.textContent = 'Vui lòng nhập đầy đủ thông tin bắt buộc (*)';
  }
  if(phone && !validatePhone(phone)){
    phoneError.textContent = 'Số điện thoại chưa hợp lệ';
    valid = false;
  }

  const chosenDate = new Date(dateVal + 'T00:00:00');
  const min = minOrderDate();
  min.setHours(0,0,0,0);
  if(chosenDate < min){
    dateError.textContent = 'Ngày nhận bánh phải từ ' + min.toLocaleDateString('vi-VN') + ' trở đi (ít nhất 2 ngày sau khi đặt)';
    valid = false;
  }

  if(!valid) return;

  const items = Object.values(cart);
  const total = items.reduce((s,i)=>s+i.price*i.qty,0);
  const itemsText = items.map(it => it.qty+'x '+it.name+' = '+fmt(it.price*it.qty)).join('\n');
  const dateStr = chosenDate.toLocaleDateString('vi-VN');

  const submitBtn = document.getElementById('submitOrderBtn');
  submitBtn.disabled = true;
  submitBtn.textContent = 'Đang gửi...';

  const finishOrder = () => {
    document.getElementById('confirmBox').innerHTML =
      '<b>Bánh đã đặt:</b><br>' + items.map(it => it.qty+'x '+it.name).join('<br>') +
      '<br><br><b>Tổng cộng:</b> ' + fmt(total) +
      '<br><br><b>Người nhận:</b> ' + name +
      '<br><b>Điện thoại:</b> ' + phone +
      '<br><b>Địa chỉ:</b> ' + address +
      '<br><b>Ngày nhận:</b> ' + dateStr +
      (note ? '<br><b>Ghi chú:</b> ' + note : '');

    Object.keys(cart).forEach(k => delete cart[k]);
    renderCart();
    toggleCheckout(false);
    toggleSuccess(true);
    document.getElementById('orderForm').reset();
    submitBtn.disabled = false;
    submitBtn.textContent = 'Xác nhận đặt hàng';
  };

  if(emailjsReady){
    emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, {
      customer_name: name,
      customer_phone: phone,
      customer_address: address,
      delivery_date: dateStr,
      order_items: itemsText,
      order_total: fmt(total),
      customer_note: note || '(không có)'
    }).then(finishOrder).catch((err) => {
      console.error('EmailJS error:', err);
      alert('Không gửi được email tự động, nhưng đơn của bạn đã được ghi nhận. Vui lòng nhắn Zalo cho shop để chắc chắn nhé!');
      finishOrder();
    });
  } else {
    finishOrder();
  }
}

