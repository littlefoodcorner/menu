async function doLogin(){
  const errorEl = document.getElementById('authError');
  if(!supabaseClient){
    errorEl.textContent = 'Chưa cấu hình Supabase trong file này.';
    return;
  }
  const email = document.getElementById('authEmail').value.trim();
  const password = document.getElementById('authPassword').value;
  if(!email || !password){ errorEl.textContent = 'Vui lòng nhập email và mật khẩu.'; return; }
  errorEl.textContent = 'Đang đăng nhập...';
  const { error } = await supabaseClient.auth.signInWithPassword({ email, password });
  if(error){
    errorEl.textContent = 'Sai email hoặc mật khẩu.';
    return;
  }
  closeAuthModal();
  document.getElementById('authEmail').value = '';
  document.getElementById('authPassword').value = '';
  setEditMode(true);
}

